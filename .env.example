# Public OAuth client IDs. These are embedded in the app bundle.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Cloudflare Worker API origin.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8787

# Sample trips are enabled automatically in local development/native preview.
# Set true only for a staging web export; production keeps this false.
EXPO_PUBLIC_ENABLE_DEMO=false
