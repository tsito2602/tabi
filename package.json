{
  "name": "tabi",
  "main": "expo-router/entry",
  "version": "1.5.0",
  "dependencies": {
    "@expo/ui": "~57.0.14",
    "expo": "~57.0.17",
    "expo-auth-session": "~57.0.11",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.15",
    "expo-crypto": "~57.0.2",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-glass-effect": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.8",
    "expo-router": "~57.0.17",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.3",
    "expo-web-browser": "~57.0.2",
    "jose": "^6.2.12",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "wrangler": "^4.92.0",
    "sharp": "^0.34.5"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "check": "npm run typecheck && npm run lint && npm run test:connections && npm run test:sync && npm run test:pwa && npm run test:theme && npm run test:ui && npm run build:web",
    "test:connections": "node scripts/test-flight-connections.mjs",
    "test:sync": "node scripts/test-travel-sync.mjs",
    "preview": "APP_VARIANT=preview expo start --go",
    "preview:ios": "APP_VARIANT=preview expo run:ios --device",
    "preview:android": "APP_VARIANT=preview expo run:android --device",
    "check:native": "expo export --platform ios --platform android",
    "build:preview:android": "npx eas-cli build --platform android --profile preview",
    "build:preview:ios": "npx eas-cli build --platform ios --profile preview",
    "build:web": "expo export --platform web && node scripts/build-pwa.mjs",
    "test:theme": "node scripts/test-theme.mjs",
    "test:pwa": "node scripts/test-pwa-api.mjs && node scripts/test-service-worker.mjs && node scripts/test-icon-check.mjs",
    "icons:export": "node scripts/export-brand.mjs",
    "test:ui": "node scripts/test-ui-boundaries.mjs"
  },
  "private": true
}
