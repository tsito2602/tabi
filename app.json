{
  "expo": {
    "name": "tabi",
    "slug": "tabi",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/brand/icon.png",
    "scheme": "tabi",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.tsito2602.tabi",
      "icon": {
        "light": "./assets/brand/icon.png",
        "dark": "./assets/brand/icon-dark.png"
      }
    },
    "android": {
      "package": "com.tsito2602.tabi",
      "adaptiveIcon": {
        "backgroundColor": "#FAFCFD",
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-system-ui",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#EEF2F4",
          "image": "./assets/brand/logo.png",
          "imageWidth": 88,
          "dark": {
            "backgroundColor": "#182A36",
            "image": "./assets/brand/logo-dark.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
